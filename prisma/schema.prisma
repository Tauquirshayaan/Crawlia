// prisma/schema.prisma
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Plans ───────────────────────────────────────────────────────────────────

model Plan {
  id                  String         @id @default(cuid())
  name                String         @unique  // FREE, BASIC, PRO, AGENCY
  displayName         String                  // "Free", "Basic", "Pro", "Agency"
  monthlyCredits      Int                     // credits granted per billing cycle
  rolloverCap         Int                     // max credits that can roll over (= 1x monthly)
  maxCampaigns        Int                     // -1 = unlimited
  maxMailboxes        Int
  maxTeamMembers      Int
  canInviteMembers    Boolean        @default(false)
  stripePriceIdMonthly  String?               // Stripe Price ID for monthly billing
  stripePriceIdAnnual   String?               // Stripe Price ID for annual billing
  monthlyPrice        Float          @default(0)  // in USD
  annualPrice         Float          @default(0)  // per month when billed annually
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  subscriptions       Subscription[]
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                   String                @id @default(cuid())
  workspaceId          String                @unique
  planId               String
  status               String                @default("ACTIVE")
  // ACTIVE, PAST_DUE, CANCELED, TRIALING, INCOMPLETE, PAUSED
  interval             String                @default("monthly") // monthly | annual
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean               @default(false)
  stripeSubscriptionId String?               @unique
  stripeCustomerId     String?
  razorpaySubId        String?               @unique
  razorpayCustomerId   String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                 Plan                  @relation(fields: [planId], references: [id])
  history              SubscriptionHistory[]
  invoices             Invoice[]
}

model SubscriptionHistory {
  id             String       @id @default(cuid())
  subscriptionId String
  event          String       // CREATED, UPGRADED, DOWNGRADED, CANCELED, RENEWED, PAYMENT_FAILED
  previousPlanId String?
  newPlanId      String?
  previousStatus String?
  newStatus      String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ─── Invoices ────────────────────────────────────────────────────────────────

model Invoice {
  id                String       @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  stripeInvoiceId   String?      @unique
  razorpayOrderId   String?      @unique
  amount            Float                    // in USD
  currency          String       @default("usd")
  status            String                   // paid, open, void, uncollectible
  pdfUrl            String?
  hostedUrl         String?
  periodStart       DateTime
  periodEnd         DateTime
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// ─── Webhook Idempotency ──────────────────────────────────────────────────────

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String             // stripe | razorpay
  eventId     String             // Stripe event.id or Razorpay event_id
  eventType   String             // checkout.session.completed, etc.
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
}

// ─── Credit Top-Ups (manual purchase) ────────────────────────────────────────

model CreditTopUp {
  id                String   @id @default(cuid())
  workspaceId       String
  credits           Int
  amountUsd         Float
  provider          String   // stripe | razorpay
  providerPaymentId String?  @unique
  status            String   @default("PENDING") // PENDING, COMPLETED, FAILED, REFUNDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Usage Records ────────────────────────────────────────────────────────────

model UsageRecord {
  id             String   @id @default(cuid())
  workspaceId    String
  feature        String   // WEBSITE_ANALYSIS | EMAIL_DRAFT | CAMPAIGN_CREATE
  resourceId     String?  // leadId, campaignId, etc.
  creditsUsed    Int
  balanceAfter   Int
  status         String   @default("SUCCESS") // SUCCESS | REFUNDED | FAILED
  metadata       Json?
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model Workspace {
  id               String             @id @default(cuid())
  name             String
  tier             String             @default("FREE") // FREE, BASIC, PRO, AGENCY
  companySize      String?
  location         String?
  stripeId         String?            @unique
  razorpayId       String?            @unique
  // Denormalized credit balance for fast reads (authoritative source is WorkspaceCredit sum)
  creditsBalance   Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  members          WorkspaceMember[]
  leads            Lead[]
  campaigns        Campaign[]
  creditsLedger    WorkspaceCredit[]
  mailboxes        Mailbox[]
  subscription     Subscription?
  usageRecords     UsageRecord[]
  creditTopUps     CreditTopUp[]
}

model User {
  id            String             @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String             @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Lead {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String?
  email         String?
  company       String?
  websiteUrl    String
  segment       String?   // Vertical tagging (e.g. "law firms", "B2B SaaS")
  /// Deduplication key — normalized root domain OR exact email, whichever is present.
  /// Prevents double-importing the same lead and double-charging credits.
  dedupeKey     String?   // e.g. "example.com" or "john@example.com"
  status        String    @default("NEW") // NEW, QUALIFIED, CONTACTED, REPLIED, BOUNCED
  score         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignLeads CampaignLead[]
  emailDrafts   EmailDraft[]
  analyses      Analysis[]
  replies       Reply[]

  @@unique([workspaceId, dedupeKey])
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String
  name           String
  status         String         @default("DRAFT") // DRAFT, RUNNING, PAUSED, COMPLETED
  type           String         @default("SMART") // SMART, GENERAL
  language       String         @default("English")
  goal           String?
  rules          Json?
  subject        String?
  scheduleRules  Json?
  mailboxId      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  mailbox        Mailbox?       @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  campaignLeads  CampaignLead[]
  emailDrafts    EmailDraft[]
}

model CampaignLead {
  id               String   @id @default(cuid())
  campaignId       String
  leadId           String
  status           String   @default("ENROLLED") // ENROLLED, DRAFTING, SCHEDULED, SENT, EXCLUDED
  step             Int      @default(1)
  /// Set when Stage 1 pre-check fails — used to surface a reason in the UI without charging a credit
  preCheckStatus   String?  // PARKED_DOMAIN | DNS_FAIL | HTTP_ERROR | TIMEOUT | BOT_WALL
  preCheckReason   String?  // human-readable detail for the UI
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead             Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
}

model Analysis {
  id                   String   @id @default(cuid())
  leadId               String
  score                Int      @default(0)
  subScores            Json?    // Raw per-category sub-scores for weight retuning
  findingsJson         Json?    // SEO signals + visual critique findings
  assetsJson           Json?    // Screenshot metadata
  /// Optional URLs to stored screenshots (if uploaded to object storage)
  screenshotDesktopUrl String?
  screenshotMobileUrl  String?
  status               String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  lead                 Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model EmailDraft {
  id         String   @id @default(cuid())
  campaignId String
  leadId     String
  subject    String
  body       String   @db.Text
  anglesJson Json?    // Stores the finding-to-angle mapping (Step A of writing engine)
  status     String   @default("DRAFT") // DRAFT, APPROVED, REJECTED
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sends      Send[]
}

model Send {
  id         String     @id @default(cuid())
  draftId    String
  mailboxId  String
  messageId  String?
  sentAt     DateTime?
  status     String     @default("PENDING") // PENDING, SENT, FAILED, DELIVERED
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  draft      EmailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mailbox    Mailbox    @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
}

model Reply {
  id         String   @id @default(cuid())
  leadId     String
  intent     String?  // POSITIVE, NEGATIVE, INFO_REQUEST, OOO, BOUNCE
  confidence Float?
  rawContent String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model WorkspaceCredit {
  id          String    @id @default(cuid())
  workspaceId String
  type        String    // ADDITION, DEDUCTION
  amount      Int       // positive = add, negative = deduct
  status      String    @default("COMMITTED") // PENDING, COMMITTED, ROLLED_BACK
  lockId      String?   @unique               // idempotency key
  description String?
  feature     String?   // WEBSITE_ANALYSIS, EMAIL_DRAFT, SUBSCRIPTION_RENEWAL, TOPUP, BONUS
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Mailbox {
  id           String     @id @default(cuid())
  workspaceId  String
  email        String
  provider     String     // google, outlook, smtp
  status       String     @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  
  accessToken  String?    @db.Text
  refreshToken String?    @db.Text
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPass     String?

  imapHost     String?
  imapPort     Int?
  imapUser     String?
  imapPass     String?

  health       Int        @default(100)
  dailyLimit   Int        @default(50)
  sentToday    Int        @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns    Campaign[]
  sends        Send[]

  @@unique([workspaceId, email])
}

